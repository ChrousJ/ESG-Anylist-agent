# LLM provider: gemini, qwen, or openai_compatible
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-preview-05-20

# Qwen/OpenAI-compatible alternative
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
QWEN_MAIN_MODEL=qwen3.5-flash
QWEN_REQUEST_TIMEOUT_SEC=60


# Generic OpenAI-compatible endpoint (AntChat / DeepSeek / private gateway)
OPENAI_BASE_URL=https://antchat.alipay.com/v1
OPENAI_API_KEY=
OPENAI_MAIN_MODEL=DeepSeek-V4-Pro
OPENAI_REQUEST_TIMEOUT_SEC=90
OPENAI_CLIENT_MAX_RETRIES=0

# Data paths
DB_PATH=./data/esg_data.db
VECTOR_STORE_DIR=./data/vector_store
BGE_EMBED_MODEL=BAAI/bge-small-zh-v1.5
BGE_RERANK_MODEL=BAAI/bge-reranker-v2-m3
CHECKPOINT_DB_PATH=./data/checkpoints.sqlite

# API
PORT=8000
CORS_ALLOW_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CORS_ALLOW_CREDENTIALS=true

# Observability and memory
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=esg-agent
LEGACY_MEMORY_READS_ENABLED=false
LEGACY_MEMORY_WRITES_ENABLED=false
QUERY_ANALYTICS_ENABLED=true

# Safety/debug switches
EXPOSE_INTERNAL_ERRORS=false
EXPOSE_TRACE_IN_RESPONSE=false
